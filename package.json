{
  "name": "topath-saver",
  "version": "0.2.0",
  "description": "Chrome extension: switch the download folder in two clicks.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "node scripts/icons.mjs && wxt prepare",
    "icons": "node scripts/icons.mjs",
    "qr": "node scripts/qr.mjs",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "stand": "wxt build && playwright test",
    "gates": "npm run compile && npm run test && npm run stand",
    "doctor": "node scripts/doctor.mjs"
  },
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "qrcode": "1.5.4",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "wxt": "0.21.4"
  },
  "private": true
}
